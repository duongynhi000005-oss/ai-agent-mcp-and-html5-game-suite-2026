{
  "actorSpecification": 1,
  "name": "ai-agent-clean-markdown-seo-security-auditor",
  "title": "AI Agent Clean Markdown Scraper, SEO & OWASP Security Auditor (PPE)",
  "description": "Scrapes clean LLM-ready Markdown, audits technical SEO & Core Vitals metadata, and scans OWASP HTTP security headers.",
  "version": "1.0",
  "meta": {
    "templateId": "js-start"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Audit & Markdown Results",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": ["url", "title", "seoScore", "securityGrade", "wordCount", "markdown"]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": { "label": "Target URL", "format": "link" },
              "title": { "label": "Page Title", "format": "text" },
              "seoScore": { "label": "SEO Score", "format": "number" },
              "securityGrade": { "label": "Security Grade", "format": "text" },
              "wordCount": { "label": "Words", "format": "number" },
              "markdown": { "label": "Clean Markdown", "format": "text" }
            }
          }
        }
      }
    }
  },
  "dockerfile": "./Dockerfile"
}