document.getElementById('btnCopyExtracted').addEventListener('click', () => {
  navigator.clipboard.writeText(document.getElementById('extractorOutput').value);
  setStatus('📋 Copied extracted content!');
});

// ================= TAB 3: DEVTOOLS SWISS-ARMY KNIFE =================
document.getElementById('btnRunDevTool').addEventListener('click', () => {
  const mode = document.getElementById('devToolMode').value;
  const input = document.getElementById('devInput').value.trim();
  const outEl = document.getElementById('devOutput');
  try {
    if (mode === 'json') {
      const parsed = JSON.parse(input);
      outEl.value = JSON.stringify(parsed, null, 2);
    } else if (mode === 'jwt') {
      const parts = input.split('.');
      if (parts.length < 2) throw new Error('Invalid JWT format (expected header.payload.signature)');
      const decodePart = (s) => JSON.parse(atob(s.replace(/-/g, '+').replace(/_/g, '/')));
      const header = decodePart(parts[0]);
      const payload = decodePart(parts[1]);
      const expInfo = payload.exp ? new Date(payload.exp * 1000).toISOString() : 'No exp claim';
      outEl.value = JSON.stringify({ header, payload, expiresAt_ISO: expInfo }, null, 2);
    } else if (mode === 'b64d') {
      outEl.value = decodeURIComponent(escape(atob(input)));
    } else if (mode === 'b64e') {
      outEl.value = btoa(unescape(encodeURIComponent(input)));
    } else if (mode === 'urld') {
      outEl.value = decodeURIComponent(input);
    } else if (mode === 'epoch') {
      if (/^\d+$/.test(input)) {
        const ms = input.length <= 10 ? Number(input) * 1000 : Number(input);
        outEl.value = `ISO-8601 UTC: ${new Date(ms).toISOString()}\nLocal Time:   ${new Date(ms).toString()}\nUnix Seconds: ${Math.floor(ms / 1000)}`;
      } else {
        const d = new Date(input);
        outEl.value = `Unix Seconds: ${Math.floor(d.getTime() / 1000)}\nUnix Millis:  ${d.getTime()}\nISO-8601 UTC: ${d.toISOString()}`;
      }
    }
    setStatus('✅ DevTool transformation complete!');
  } catch (err) {
    outEl.value = 'Error: ' + err.message;
    setStatus('⚠️ Format error');
  }
});

document.getElementById('btnCopyDevOutput').addEventListener('click', () => {
  navigator.clipboard.writeText(document.getElementById('devOutput').value);
  setStatus('📋 Copied DevTool result!');
});

