// ================= TAB 6: POMODORO FOCUS TIMER =================
let pomoSeconds = 25 * 60;
let pomoTimer = null;
const pomoEl = document.getElementById('pomoDisplay');
function updatePomoUI() {
  const m = String(Math.floor(pomoSeconds / 60)).padStart(2, '0');
  const s = String(pomoSeconds % 60).padStart(2, '0');
  pomoEl.textContent = m + ':' + s;
}
document.getElementById('btnPomoStart').addEventListener('click', () => {
  if (pomoTimer) {
    clearInterval(pomoTimer);
    pomoTimer = null;
    setStatus('⏸️ Pomodoro paused');
  } else {
    pomoTimer = setInterval(() => {
      if (pomoSeconds > 0) { pomoSeconds--; updatePomoUI(); }
      else { clearInterval(pomoTimer); pomoTimer = null; setStatus('🎉 Focus session complete!'); }
    }, 1000);
    setStatus('🔥 Deep-Work Focus running...');
  }
});
document.getElementById('btnPomoReset').addEventListener('click', () => {
  if (pomoTimer) { clearInterval(pomoTimer); pomoTimer = null; }
  pomoSeconds = 25 * 60;
  updatePomoUI();
});
document.getElementById('btnPomoBreak').addEventListener('click', () => {
  if (pomoTimer) { clearInterval(pomoTimer); pomoTimer = null; }
  pomoSeconds = 5 * 60;
  updatePomoUI();
});
