// ================= TAB 1: AI PROMPT VAULT =================
function applyVars(text) {
  const rawVars = (document.getElementById('pVars').value || '').split(',').map(s => s.trim()).filter(Boolean);
  let idx = 0;
  return text.replace(/\{\{([^}]+)\}\}/g, (match, name) => {
    const val = rawVars[idx++];
    return val !== undefined ? val : match;
  });
}

function injectIntoPage(text) {
  chrome.tabs.query({ active: true, currentWindow: true }, (tabs) => {
    if (!tabs[0]) return;
    chrome.scripting.executeScript({
      target: { tabId: tabs[0].id },
      func: (promptText) => {
        const el = document.querySelector('#prompt-textarea, textarea, [contenteditable="true"]');
        if (!el) {
          navigator.clipboard.writeText(promptText);
          alert('Copied to clipboard! (No active chat box found on this tab)');
          return;
        }
        el.focus();
        if (el.tagName === 'TEXTAREA' || el.tagName === 'INPUT') {
          el.value = promptText;
          el.dispatchEvent(new Event('input', { bubbles: true }));
        } else {
          el.innerText = promptText;
          el.dispatchEvent(new InputEvent('input', { bubbles: true }));
        }
      },
      args: [text]
    });
    setStatus('⚡ Injected into active tab!');
  });
}

function renderPrompts(prompts) {
  const list = document.getElementById('promptList');
  document.getElementById('promptCount').textContent = prompts.length + ' templates';
  list.innerHTML = '';
  prompts.forEach((p, idx) => {
    const div = document.createElement('div');
    div.className = 'item';
    div.innerHTML = `
      <div class="item-top">
        <span>${p.title}</span>
        <div style="display:flex;gap:4px;">
          <button class="btn green" style="padding:2px 7px;font-size:10px;" data-act="use" data-idx="${idx}">⚡ Inject</button>
          <button class="btn secondary" style="padding:2px 7px;font-size:10px;" data-act="copy" data-idx="${idx}">📋</button>
          <button class="btn secondary" style="padding:2px 7px;font-size:10px;" data-act="del" data-idx="${idx}">✕</button>
        </div>
      </div>
      <div class="item-body">${p.body}</div>
    `;
    list.appendChild(div);
  });

  list.querySelectorAll('button').forEach(b => {
    b.addEventListener('click', () => {
      const i = Number(b.dataset.idx);
      const act = b.dataset.act;
      const finalPrompt = applyVars(prompts[i].body);
      if (act === 'use') injectIntoPage(finalPrompt);
      if (act === 'copy') {
        navigator.clipboard.writeText(finalPrompt);
        setStatus('📋 Copied prompt with variables!');
      }
      if (act === 'del') {
        prompts.splice(i, 1);
        chrome.storage.local.set({ omniwork_prompts: prompts }, () => renderPrompts(prompts));
      }
    });
  });
}

chrome.storage.local.get({ omniwork_prompts: DEFAULT_PROMPTS, omniwork_pro: false, omniwork_profile: {}, omniwork_note: '' }, (res) => {
  renderPrompts(res.omniwork_prompts);
  if (res.omniwork_pro) document.getElementById('proBadge').textContent = '👑 PRO ACTIVE';
  if (res.omniwork_profile) {
    document.getElementById('afName').value = res.omniwork_profile.name || '';
    document.getElementById('afEmail').value = res.omniwork_profile.email || '';
    document.getElementById('afPhone').value = res.omniwork_profile.phone || '';
    document.getElementById('afCompany').value = res.omniwork_profile.company || '';
    document.getElementById('afBio').value = res.omniwork_profile.bio || '';
  }
  if (res.omniwork_note) document.getElementById('pageNoteInput').value = res.omniwork_note;
});

document.getElementById('btnSavePrompt').addEventListener('click', () => {
  const title = document.getElementById('pTitle').value.trim();
  const body = document.getElementById('pBody').value.trim();
  if (!title || !body) return setStatus('⚠️ Enter title and prompt template');
  chrome.storage.local.get({ omniwork_prompts: DEFAULT_PROMPTS }, (res) => {
    const next = [{ title, body }, ...res.omniwork_prompts];
    chrome.storage.local.set({ omniwork_prompts: next }, () => {
      document.getElementById('pTitle').value = '';
      document.getElementById('pBody').value = '';
      renderPrompts(next);
      setStatus('✅ Saved template!');
    });
  });
});

document.getElementById('btnInjectPrompt').addEventListener('click', () => {
  const body = document.getElementById('pBody').value.trim();
  if (!body) return setStatus('⚠️ Write a prompt or click Inject on a saved card');
  injectIntoPage(applyVars(body));
});

// ================= TAB 2: WEB EXTRACTOR & CLIPPER =================
function runInActiveTab(fn, cb) {
  chrome.tabs.query({ active: true, currentWindow: true }, (tabs) => {
    if (!tabs[0]) return;
    chrome.scripting.executeScript({ target: { tabId: tabs[0].id }, func: fn }, (results) => {
      if (results && results[0]) cb(results[0].result);
    });
  });
}

document.getElementById('btnExtractMd').addEventListener('click', () => {
  runInActiveTab(() => {
    const title = document.title;
    const url = location.href;
    const headings = Array.from(document.querySelectorAll('h1, h2, h3')).map(h => h.tagName + ': ' + h.innerText.trim()).slice(0, 30).join('\n');
    const bodyText = (document.querySelector('article, main') || document.body).innerText.replace(/\n{3,}/g, '\n\n').slice(0, 12000);
    return `# ${title}\nURL: ${url}\n\n## Outline\n${headings}\n\n## Content\n${bodyText}`;
  }, (md) => {
    document.getElementById('extractorOutput').value = md || '';
    setStatus('📄 Extracted clean Markdown from page!');
  });
});

document.getElementById('btnExtractLinks').addEventListener('click', () => {
  runInActiveTab(() => {
    const links = Array.from(document.querySelectorAll('a[href]'))
      .map(a => `- [${(a.innerText || a.href).trim().slice(0, 60)}](${a.href})`)
      .filter((v, i, arr) => arr.indexOf(v) === i)
      .slice(0, 100)
      .join('\n');
    return `# Extracted Links (${location.hostname})\n\n${links}`;
  }, (out) => {
    document.getElementById('extractorOutput').value = out || '';
    setStatus('🔗 Extracted top 100 unique links!');
  });
});

document.getElementById('btnBuildSummaryPrompt').addEventListener('click', () => {
  const md = document.getElementById('extractorOutput').value.trim();
  const promptText = `Summarize the following web page into: (1) 3-sentence Executive Summary, (2) Key Technical/Business Facts, and (3) Actionable Next Steps:\n\n${md || '[Click Extract Page first]'}`;
