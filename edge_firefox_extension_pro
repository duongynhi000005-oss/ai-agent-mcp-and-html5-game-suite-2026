document.getElementById('btnToggleReader').addEventListener('click', () => {
  runInActiveTab(() => {
    const existing = document.getElementById('omniwork-reader-overlay');
    if (existing) { existing.remove(); return 'Reader Mode OFF'; }
    const article = (document.querySelector('article, main') || document.body).innerText;
